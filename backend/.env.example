DATABASE_URL="postgresql://user:password@localhost:5432/jobtrack"
PORT=8080
FRONTEND_URL=http://localhost:5173

# Firebase Admin (service account JSON, base64-encoded)
FIREBASE_SERVICE_ACCOUNT_B64=

# Google OAuth (Gmail API) - from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback

# 32-byte hex key for AES-256-GCM token encryption: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Optional: enables Claude-powered extraction (falls back to rules if empty)
ANTHROPIC_API_KEY=
